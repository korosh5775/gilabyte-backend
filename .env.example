PORT=8000

JWT_SECRET=your_jwt_secret_here

MONGO_URI=mongodb://localhost/gilabyte

ADMIN_PHONE_NUMBER=09xxxxxxxxx

# SMS.ir
SMSIR_API_KEY=your_smsir_api_key
SMSIR_LINE_NUMBER=your_smsir_line_number
SMSIR_OTP_TEMPLATE_ID=your_template_id

# Zarinpal
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_PAYMENT_URL=https://sandbox.zarinpal.com/pg/v4/payment
ZARINPAL_GATEWAY_URL=https://sandbox.zarinpal.com/pg/StartPay
ZARINPAL_CALLBACK_URL=http://yourdomain.ir/api/v1.1/users/payment-callback
ZARINPAL_CALLBACK_URL_BARBER=http://yourdomain.ir/api/v1.1/users/appointments/payment-callback

FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------
# App Version — Force Update (React Native Admin App)
# Used by GET /api/v1.1/shared/app-version (public, no auth required)
# -----------------------------------------------------------------------
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.yourapp
APP_UPDATE_URL_IOS=https://apps.apple.com/app/idYOURAPPID
